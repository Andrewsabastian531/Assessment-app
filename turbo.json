{
  "$schema": "https://turbo.build/schema.json",
  // "stream" rather than "tui": the interactive TUI does not forward Ctrl+C
  // reliably in Git Bash / mintty on Windows, which orphans the dev servers.
  "ui": "stream",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "DIRECT_URL",
    "REDIS_URL",
    "AUTH_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "lint": { "dependsOn": ["^build"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"], "outputs": ["coverage/**"] },
    "generate": { "cache": false },
    "migrate": { "cache": false, "persistent": true },
    "push": { "cache": false },
    "studio": { "cache": false, "persistent": true },
    "seed": { "cache": false }
  }
}
