# Copy to .env and fill in. Both apps read this one file.
#
#   cp .env.example .env

# ---- Database -----------------------------------------------------------
# Defaults match docker-compose.yml. On a pooled host (Supabase, Neon) set
# DIRECT_URL to the non-pooled string; Prisma Migrate needs it for DDL.
DATABASE_URL="postgresql://vedaai:vedaai@localhost:5434/vedaai?schema=public"
DIRECT_URL="postgresql://vedaai:vedaai@localhost:5434/vedaai?schema=public"

# ---- Queue --------------------------------------------------------------
# Upstash and other TLS hosts need rediss:// (two s).
REDIS_URL="redis://localhost:6380"
WORKER_CONCURRENCY=4

# ---- Auth ---------------------------------------------------------------
# Must be identical for both apps. Generate: openssl rand -base64 32
AUTH_SECRET=""
JWT_EXPIRES_IN="7d"

# Optional. Leave both blank and the Google button is hidden.
# console.cloud.google.com -> Credentials -> OAuth client ID -> Web application
# Authorised redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Only needed when the callback host differs from the app origin.
GOOGLE_REDIRECT_URI=""

# ---- Object storage -----------------------------------------------------
# Defaults point at the local MinIO container. For Cloudflare R2, swap the
# endpoint for https://<ACCOUNT_ID>.r2.cloudflarestorage.com, set
# S3_FORCE_PATH_STYLE=false, and add a CORS rule allowing PUT from the web
# origin or the browser upload is blocked.
S3_ENDPOINT="http://localhost:9002"
S3_REGION="auto"
S3_ACCESS_KEY_ID="vedaai"
S3_SECRET_ACCESS_KEY="vedaai-secret"
S3_BUCKET="vedaai-uploads"
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL="http://localhost:9002/vedaai-uploads"

# ---- AI engine ----------------------------------------------------------
# google | openrouter | opencode-zen | openai | ollama
# The model must accept image input and structured JSON output; not every
# free model does. Verify with GET /api/v1/health/ai after changing it.
AI_PROVIDER="google"
AI_VISION_MODEL="gemini-3.6-flash"
AI_GRADING_MODEL="gemini-3.6-flash"
AI_MAX_RETRIES=3
AI_REQUEST_TIMEOUT_MS=120000

# Free key: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=""

OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_SITE_URL="http://localhost:3000"
OPENROUTER_APP_NAME="VedaAI"
OPENCODE_ZEN_API_KEY=""
OPENCODE_ZEN_BASE_URL="https://opencode.ai/zen/v1"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# ---- Embeddings ---------------------------------------------------------
# Used to match answers to questions. gemini-embedding-001 returns 3072
# dimensions unless asked for fewer; the request pins it to the value below.
# Changing the width requires a Prisma migration.
EMBEDDING_PROVIDER="google"
EMBEDDING_MODEL="gemini-embedding-001"
EMBEDDING_DIMENSIONS=768
VOYAGE_API_KEY=""

# ---- Services -----------------------------------------------------------
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="http://localhost:4000"
CORS_ORIGINS="http://localhost:3000"

# Set to 1 to click through the UI with uploads simulated in the browser and
# no API running. Off by default so a broken deploy fails loudly.
NEXT_PUBLIC_UI_PREVIEW=0
