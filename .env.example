####################################################################
# VedaAI — root environment file
#
#   cp .env.example .env
#
# Turborepo loads this at the root and both apps read from it, so you
# only maintain ONE file. App-specific overrides go in apps/*/.env.local
####################################################################


# ──────────────────────────────────────────────────────────────────
# DATABASE  (Checkpoint B)
# ──────────────────────────────────────────────────────────────────
# Local (docker compose up -d) — matches docker-compose.yml exactly.
DATABASE_URL="postgresql://vedaai:vedaai@localhost:5434/vedaai?schema=public"

# Supabase / Neon: DATABASE_URL is the POOLED (pgbouncer) connection used at
# runtime; DIRECT_URL is the direct connection Prisma Migrate needs, because
# migrations issue DDL that a connection pooler cannot proxy.
# Leave DIRECT_URL equal to DATABASE_URL when running locally.
DIRECT_URL="postgresql://vedaai:vedaai@localhost:5434/vedaai?schema=public"


# ──────────────────────────────────────────────────────────────────
# REDIS  (BullMQ queues)  (Checkpoint B)
# ──────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6380"
# Upstash uses TLS — the scheme must be rediss:// (two s):
# REDIS_URL="rediss://default:<password>@<host>.upstash.io:6379"

# How many pipeline jobs one worker process runs at once. Raise on a bigger box;
# lower it if you hit your AI provider's rate limit.
WORKER_CONCURRENCY=4


# ──────────────────────────────────────────────────────────────────
# AUTH
# ──────────────────────────────────────────────────────────────────
# The SAME secret must be set for web and api — Auth.js signs the JWT with it
# and NestJS verifies it. Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
JWT_EXPIRES_IN="7d"

# Optional — enables the "Sign in with Google" button. Leave blank to use
# email + password only. Create credentials at console.cloud.google.com, with
# redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# ──────────────────────────────────────────────────────────────────
# OBJECT STORAGE — Cloudflare R2 (S3-compatible)
# ──────────────────────────────────────────────────────────────────
# LOCAL DEV (MinIO, started by docker compose) — works with zero cloud setup:
S3_ENDPOINT="http://localhost:9002"
S3_REGION="auto"
S3_ACCESS_KEY_ID="vedaai"
S3_SECRET_ACCESS_KEY="vedaai-secret"
S3_BUCKET="vedaai-uploads"
S3_FORCE_PATH_STYLE=true
# Public base URL used to build page-image links. MinIO serves path-style.
S3_PUBLIC_URL="http://localhost:9002/vedaai-uploads"

# PRODUCTION (Cloudflare R2) — swap the five values above for these:
#   Dashboard → R2 → Manage API Tokens → Create token (Object Read & Write)
# S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_ACCESS_KEY_ID="<R2 access key id>"
# S3_SECRET_ACCESS_KEY="<R2 secret access key>"
# S3_BUCKET="vedaai-uploads"
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_URL="https://<your-r2-public-domain>"
#
# ⚠️ R2 requires a CORS policy on the bucket or the browser PUT will be blocked:
#   [{ "AllowedOrigins": ["http://localhost:3000"],
#      "AllowedMethods": ["PUT","GET","HEAD"],
#      "AllowedHeaders": ["*"], "ExposeHeaders": ["ETag"] }]


# ──────────────────────────────────────────────────────────────────
# AI ENGINE — vision + grading models
# ──────────────────────────────────────────────────────────────────
# Provider driving the vision/grading calls.
#   google | openrouter | opencode-zen | anthropic | openai | ollama
AI_PROVIDER="google"

# OpenRouter (has a free tier — models suffixed ":free")
#   Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# Sent by OpenRouter as attribution; optional but recommended.
OPENROUTER_SITE_URL="http://localhost:3000"
OPENROUTER_APP_NAME="VedaAI"

# Google AI Studio (generous free tier, strong vision)
#   Key: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=""

# OpenCode Zen (OpenAI-compatible gateway; the "Ox Alpha Free" family lives here).
# Requires a Zen API key. Note: confirm the model you pick accepts IMAGE input —
# coding-oriented models in this catalogue are text-only and will fail the
# layout-analysis stage.
OPENCODE_ZEN_API_KEY=""
OPENCODE_ZEN_BASE_URL="https://opencode.ai/zen/v1"

# Anthropic (paid; best quality for step-by-step math grading)
ANTHROPIC_API_KEY=""

# Ollama (fully local, no key, no cost — needs a vision model pulled)
OLLAMA_BASE_URL="http://localhost:11434"

# Model IDs. These are the ONLY place a model is named — swapping providers is
# an env change, never a code change.
#   AI_VISION_MODEL   → layout analysis + handwriting transcription (high volume)
#   AI_GRADING_MODEL  → rubric grading + question extraction (needs reasoning)
AI_VISION_MODEL="gemini-3.6-flash"
AI_GRADING_MODEL="gemini-3.6-flash"

# Guard rails so a runaway page never burns the whole quota.
AI_MAX_RETRIES=3
AI_REQUEST_TIMEOUT_MS=120000


# ──────────────────────────────────────────────────────────────────
# EMBEDDINGS — semantic question ⇄ answer matching
# ──────────────────────────────────────────────────────────────────
#   google → gemini-embedding-001, requested at 768 dims  ← default
#   local  → bge-small-en-v1.5 in-process, no key, but 384-dim (needs migration)
#   voyage | openai → hosted alternatives
EMBEDDING_PROVIDER="google"
EMBEDDING_MODEL="gemini-embedding-001"
# gemini-embedding-001 defaults to 3072 dims but accepts an explicit smaller
# size; the API asks for exactly this value. Changing it REQUIRES a Prisma
# migration — the vector column dimension is fixed in the schema.
EMBEDDING_DIMENSIONS=768

VOYAGE_API_KEY=""
OPENAI_API_KEY=""


# ──────────────────────────────────────────────────────────────────
# SERVICE URLS
# ──────────────────────────────────────────────────────────────────
API_PORT=4000
WEB_PORT=3000

# Read by the browser — must be NEXT_PUBLIC_ prefixed to be exposed client-side.
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="http://localhost:4000"

# Origins the NestJS CORS filter accepts (comma-separated).
CORS_ORIGINS="http://localhost:3000"
